@@ -0,0 +1,36 @@
+use crate::{Error, Result};
+use std::{marker::PhantomData, os::unix::fs::MetadataExt, rc::Rc};
+/// !Send/!Sync; a worker and all clients stay on its dedicated placed thread.
+/// Private fields and no production constructor: observed namespace metadata
+/// alone must never authorize an arbitrary host namespace.
+pub(crate) struct Placed {
+    identity: (u64, u64),
+    _thread: PhantomData<Rc<()>>,
+}
+impl Placed {
+    pub fn check(&self) -> Result<()> {
+        if identity()? == self.identity {
+            Ok(())
+        } else {
+            Err(Error::NamespaceChanged)
+        }
+    }
+    #[cfg(test)]
+    pub fn wrong_namespace() -> Self {
+        Self {
+            identity: (0, 0),
+            _thread: PhantomData,
+        }
+    }
+    #[cfg(test)]
+    pub fn synthetic() -> Self {
+        Self {
+            identity: identity().unwrap(),
+            _thread: PhantomData,
+        }
+    }
+}
+fn identity() -> Result<(u64, u64)> {
+    let m = std::fs::metadata("/proc/thread-self/ns/net").map_err(|_| Error::NamespaceChanged)?;
+    Ok((m.dev(), m.ino()))
+}
diff --git a/crates/vprouter-worker/src/provider.rs b/crates/vprouter-worker/src/provider.rs
new file mode 100644
index 0000000..5018d70
--- /dev/null
+++ b/crates/vprouter-worker/src/provider.rs
@@ -0,0 +1,155 @@
+use crate::{
+    Error, Result,
+    client::{ATTEMPT, Http},
+    dns, json,
+    placement::Placed,
+};
+use serde::Deserialize;
+use std::{
+    net::{Ipv4Addr, SocketAddrV4},
+    rc::Rc,
+    sync::Arc,
+};
+use tokio::{net::TcpStream, time::timeout};
+use tokio_rustls::TlsConnector;
+const LIMIT: usize = 16384;
+#[derive(Deserialize)]
+struct Document {
+    mullvad_exit_ip: bool,
+    ip: Ipv4Addr,
+    mullvad_exit_ip_hostname: String,
+}
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct Confirmation {
+    pub ip: Ipv4Addr,
+    pub server: String,
+}
+pub(crate) fn parse(bytes: &[u8], expected: &str) -> Result<Confirmation> {
+    if bytes.len() > LIMIT {
+        return Err(Error::Oversized);
+    }
+    let d: Document = json::decode(bytes)?;
+    if !d.mullvad_exit_ip || !vprouter_core::profile::public_ipv4(d.ip) {
+        return Err(Error::ProviderNegative);
+    }
+    if d.mullvad_exit_ip_hostname != expected {
+        return Err(Error::WrongServer);
+    }
+    Ok(Confirmation {
+        ip: d.ip,
+        server: d.mullvad_exit_ip_hostname,
+    })
+}
+/// Reusable HTTPS session belongs to exactly one verified placed worker thread.
+/// Fixed URL/SNI; no arbitrary endpoint or root store in the production API.
+pub(crate) struct Provider {
+    placed: Rc<Placed>,
+    connector: TlsConnector,
+    dns: SocketAddrV4,
+    http: Option<Http>,
+    expected: String,
+    #[cfg(test)]
+    address: Option<std::net::SocketAddr>,
+}
+impl Provider {
+    pub fn new(placed: Rc<Placed>, dns: Ipv4Addr, expected: &str) -> Result<Self> {
+        placed.check()?;
+        vprouter_core::state::HealthMachine::new(
+            vprouter_core::config::ExitMode::Mullvad,
+            Some(expected),
+            "validation",
+        )
+        .map_err(|_| Error::InvalidConfiguration)?;
+        // Explicit Mullvad DNS must be a private tunnel destination. Public DNS
+        // and arbitrary host resolver config are not an accepted policy here.
+        if !dns.is_private() {
+            return Err(Error::InvalidConfiguration);
+        }
+        let roots =
+            rustls::RootCertStore::from_iter(webpki_roots::TLS_SERVER_ROOTS.iter().cloned());
+        Self::with_roots(placed, dns, expected, roots)
+    }
+    fn with_roots(
+        placed: Rc<Placed>,
+        dns: Ipv4Addr,
+        expected: &str,
+        roots: rustls::RootCertStore,
+    ) -> Result<Self> {
+        placed.check()?;
+        let config = rustls::ClientConfig::builder_with_provider(Arc::new(
+            rustls::crypto::ring::default_provider(),
+        ))
+        .with_safe_default_protocol_versions()
+        .map_err(|_| Error::Tls)?
+        .with_root_certificates(roots)
+        .with_no_client_auth();
+        Ok(Self {
+            placed,
+            connector: TlsConnector::from(Arc::new(config)),
+            dns: SocketAddrV4::new(dns, 53),
+            http: None,
+            expected: expected.into(),
+            #[cfg(test)]
+            address: None,
+        })
+    }
+    pub async fn confirm(&mut self) -> Result<Confirmation> {
+        self.placed.check()?;
+        let result = timeout(ATTEMPT, self.attempt())
+            .await
+            .map_err(|_| Error::Deadline)
+            .and_then(|r| r);
+        if result.is_err() {
+            self.http = None;
+        }
+        self.placed.check()?;
+        result
+    }
+    pub fn cancel(&mut self) {
+        self.http = None;
+    }
+    async fn attempt(&mut self) -> Result<Confirmation> {
+        if self.http.is_none() {
+            #[cfg(test)]
+            let address = match self.address {
+                Some(a) => a,
+                None => std::net::SocketAddr::from(SocketAddrV4::new(
+                    dns::resolve(self.dns).await?,
+                    443,
+                )),
+            };
+            #[cfg(not(test))]
+            let address = SocketAddrV4::new(dns::resolve(self.dns).await?, 443);
+            self.placed.check()?;
+            let tcp = TcpStream::connect(address)
+                .await
+                .map_err(|_| Error::Transport)?;
+            let name =
+                rustls::pki_types::ServerName::try_from(dns::PROVIDER).map_err(|_| Error::Tls)?;
+            let tls = self
+                .connector
+                .connect(name, tcp)
+                .await
+                .map_err(|_| Error::Tls)?;
+            self.http = Some(Http::connect(tls).await?);
+        }
+        let reply = self
+            .http
+            .as_mut()
+            .ok_or(Error::Transport)?
+            .request("GET", "/json", dns::PROVIDER, b"", LIMIT)
+            .await?;
+        parse(&reply.body, &self.expected)
+    }
+    #[cfg(test)]
+    pub fn synthetic(
+        placed: Rc<Placed>,
+        roots: rustls::RootCertStore,
+        address: std::net::SocketAddr,
+    ) -> Self {
+        let mut p =
+            Self::with_roots(placed, "10.64.0.1".parse().unwrap(), "de-fra-wg-404", roots).unwrap();
+        p.address = Some(address);
+        p
+    }
+}
diff --git a/crates/vprouter-worker/src/publish.rs b/crates/vprouter-worker/src/publish.rs
new file mode 100644
index 0000000..3d41919
--- /dev/null
+++ b/crates/vprouter-worker/src/publish.rs
@@ -0,0 +1,148 @@
+//! Descriptor-relative protected atomic health publication in private /state.
+use crate::{Error, Result};
+use rustix::fs::{self, FileType, Mode, OFlags};
+use std::sync::{
+    Arc,
+    atomic::{AtomicBool, Ordering},
+    mpsc,
+};
+use std::{
+    io::Write,
+    os::fd::{AsFd, OwnedFd},
+};
+use tokio::sync::oneshot;
+use vprouter_core::state::Status;
+struct Publication {
+    bytes: Vec<u8>,
+    ack: oneshot::Sender<Result<()>>,
+}
+pub(crate) struct Publisher {
+    queue: mpsc::SyncSender<Publication>,
+    in_flight: Arc<AtomicBool>,
+}
+struct Writer {
+    directory: OwnedFd,
+    uid: u32,
+    gid: u32,
+}
+impl Publisher {
+    // Namespace-local writer is created only after verified placement. A stalled
+    // disk syscall cannot occupy the monitor thread or build an unbounded queue.
+    // There is no join in Drop; separate init must bound process termination.
+    fn placed(
+        placed: &crate::placement::Placed,
+        writer: Writer,
+        #[cfg(test)] stall: Option<mpsc::Receiver<()>>,
+    ) -> Result<Self> {
+        placed.check()?;
+        let (queue, rx) = mpsc::sync_channel::<Publication>(1);
+        let in_flight = Arc::new(AtomicBool::new(false));
+        let lane = in_flight.clone();
+        std::thread::Builder::new()
+            .name("health-writer".into())
+            .spawn(move || {
+                #[cfg(test)]
+                if let Some(stall) = stall {
+                    let _ = stall.recv();
+                }
+                while let Ok(job) = rx.recv() {
+                    let result = writer.write(&job.bytes);
+                    lane.store(false, Ordering::Release);
+                    let _ = job.ack.send(result);
+                }
+            })
+            .map_err(|_| Error::Storage)?;
+        placed.check()?;
+        Ok(Self { queue, in_flight })
+    }
+    pub async fn write(&self, status: &Status) -> Result<()> {
+        let bytes = serde_json::to_vec(status).map_err(|_| Error::Storage)?;
+        if bytes.len() > 16384 {
+            return Err(Error::Storage);
+        }
+        self.in_flight
+            .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+            .map_err(|_| Error::Storage)?;
+        let (ack, rx) = oneshot::channel();
+        if self.queue.try_send(Publication { bytes, ack }).is_err() {
+            self.in_flight.store(false, Ordering::Release);
+            return Err(Error::Storage);
+        }
+        tokio::time::timeout(std::time::Duration::from_secs(2), rx)
+            .await
+            .map_err(|_| Error::Storage)?
+            .map_err(|_| Error::Storage)?
+    }
+    #[cfg(test)]
+    pub fn synthetic(directory: OwnedFd) -> Self {
+        Self::synthetic_stall(directory, None)
+    }
+    #[cfg(test)]
+    pub fn synthetic_stall(directory: OwnedFd, stall: Option<mpsc::Receiver<()>>) -> Self {
+        let s = fs::fstat(&directory).unwrap();
+        Self::placed(
+            &crate::placement::Placed::synthetic(),
+            Writer {
+                directory,
+                uid: s.st_uid,
+                gid: s.st_gid,
+            },
+            stall,
+        )
+        .unwrap()
+    }
+}
+impl Writer {
+    fn write(&self, encoded: &[u8]) -> Result<()> {
+        let st = fs::fstat(&self.directory).map_err(|_| Error::Storage)?;
+        if FileType::from_raw_mode(st.st_mode) != FileType::Directory
+            || st.st_mode & 0o7777 != 0o700
+            || st.st_uid != self.uid
+            || st.st_gid != self.gid
+        {
+            return Err(Error::Storage);
+        }
+        match fs::statat(
+            &self.directory,
+            "health.json",
+            fs::AtFlags::SYMLINK_NOFOLLOW,
+        ) {
+            Ok(s)
+                if FileType::from_raw_mode(s.st_mode) == FileType::RegularFile
+                    && s.st_mode & 0o7777 == 0o600
+                    && s.st_uid == self.uid
+                    && s.st_gid == self.gid
+                    && s.st_nlink == 1 => {}
+            Err(rustix::io::Errno::NOENT) => {}
+            _ => return Err(Error::Storage),
+        }
+        let fd = fs::openat(
+            &self.directory,
+            ".health.json.pending",
+            OFlags::WRONLY | OFlags::CREATE | OFlags::EXCL | OFlags::NOFOLLOW | OFlags::CLOEXEC,
+            Mode::RUSR | Mode::WUSR,
+        )
+        .map_err(|_| Error::Storage)?;
+        let result = (|| {
+            let mut file = std::fs::File::from(fd);
+            file.write_all(encoded).map_err(|_| Error::Storage)?;
+            fs::fsync(file.as_fd()).map_err(|_| Error::Storage)?;
+            fs::renameat(
+                &self.directory,
+                ".health.json.pending",
+                &self.directory,
+                "health.json",
+            )
+            .map_err(|_| Error::Storage)?;
+            fs::fsync(&self.directory).map_err(|_| Error::Storage)
+        })();
+        if result.is_err() {
+            let _ = fs::unlinkat(
+                &self.directory,
+                ".health.json.pending",
+                fs::AtFlags::empty(),
+            );
+        }
+        result
+    }
+}
diff --git a/crates/vprouter-worker/src/tests.rs b/crates/vprouter-worker/src/tests.rs
